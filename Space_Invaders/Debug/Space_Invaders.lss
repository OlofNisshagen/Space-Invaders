0000be e340                      	ldi		r20, 0b00110000 ;0x30, 3 gånger 
0000bf 940e 00fa                 	call	SEND_NIBBLE
0000c1 e035                          ldi		r19, 5
0000c2 940e 0290                     call	LCD_DELAY ;vänta 5ms
                                 
0000c4 940e 00fa                 	call	SEND_NIBBLE
0000c6 e031                          ldi		r19, 1
0000c7 940e 0290                     call	LCD_DELAY  ;vänta 1ms
                                 
0000c9 940e 00fa                 	call	SEND_NIBBLE
0000cb e240                      	ldi		r20, 0b00100000   ; Steg 4: 0x20 växla till 4-bit  
0000cc 940e 00fa                 	call	SEND_NIBBLE 
                                 
0000ce e240                      	ldi		r20, $20 	;function set
0000cf 940e 00fa                 	call	SEND_NIBBLE 
0000d1 ec40                      	ldi		r20,0b11000000
0000d2 940e 00fa                 	call	SEND_NIBBLE  
                                 
0000d4 2744                      	clr		r20
0000d5 940e 00fa                 	call	SEND_NIBBLE 
