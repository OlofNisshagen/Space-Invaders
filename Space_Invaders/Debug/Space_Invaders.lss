0000fb 6048                      	ori		r20, 0b00001000		;BL = 1 
0000fc 7f4b                          andi	r20, 0b11111011    ;E = 0
0000fd 930f
0000fe df9f
0000ff e200
000100 0f00
000101 b903
000102 dfa9
000103 910f
000104 2f04
000105 dfa1
000106 df9a                          tout	LCD_ADDR, r20
000107 6044                          ori		r20, 0b00000100	    ; E = 1
000108 930f
000109 df94
00010a e200
00010b 0f00
00010c b903
00010d df9e
00010e 910f
00010f 2f04
000110 df96
000111 df8f                          tout	LCD_ADDR, r20
000112 7f4b                          andi	r20, 0b11111011	 ; E = 0
000113 930f
000114 df89
000115 e200
