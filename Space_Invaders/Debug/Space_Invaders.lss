000049 e001                      	ldi		r16, 1
00004a 9516                      	lsr		r17
00004b 2311                      	tst		r17
00004c f019                      	breq	CONVERT_EXIT
                                 CONVERT_LOOP:
00004d 0f00                      	lsl		r16
00004e 951a                      	dec		r17
00004f f7e9                      	brne	CONVERT_LOOP
                                 CONVERT_EXIT:
000050 9500                      	com		r16
000051 911f                      	pop		r17
                                 .include "interrupts.asm"
000052 9508                      
                                 INTERRUPT_INIT: 
000053 e00d                      	ldi		r16,(1<<WGM01) | (1<<CS02) | (0<<CS01) | (1<<CS00)
000054 bf03                      	out		TCCR0,r16  
000055 e00e                      	ldi		r16,(1<<WGM21) | (1<<CS22) | (1<<CS21) | (0<<CS20)
000056 bd05                      	out		TCCR2,r16  
000057 e005                      	ldi		r16,5
000058 bf0c                      	out		OCR0,r16 
000059 e001                      	ldi		r16,1
00005a bd03                      	out		OCR2,r16 
00005b e802                      	ldi		r16,(1<<OCIE2) | (1<<OCIE0)
00005c bf09                      	out		TIMSK,r16 
00005d 9508                      	ret
                                 
                                 TIMER0_ISR: 
00005e 930f                      	push	r16 
00005f b70f                      	in		r16, SREG 
000060 930f                      	push	r16
000061 931f                      	push	r17
000062 932f                      	push	r18
                                 
000063 dfc5                      	rcall	DAMATRIX_ROW 
                                 	
000064 912f                      	pop		r18
000065 911f                      	pop		r17
000066 910f                      	pop		r16
000067 bf0f                      	out		SREG, r16
000068 910f                      	pop		r16
000069 9518                      	reti
                                 
                                 TIMER2_ISR:
00006a 930f                      	push	r16
00006b b70f                      	in		r16, SREG
00006c 930f                      	push	r16
00006d 931f                      	push	r17
00006e 932f                      	push	r18
00006f 933f                      	push	r19
000070 934f                      	push	r20
000071 935f                      	push	r21
000072 938f                      	push	r24
000073 93af                      	push	XL
000074 93bf                      	push	XH
                                 
000075 d3ca                      	rcall	GENERATE_SOUND
000076 d295                      	rcall	RANDOMIZE_SEED
                                 
000077 91bf                      	pop		XH
000078 91af                      	pop		XL
000079 918f                      	pop		r24
00007a 915f                      	pop		r21
00007b 914f                      	pop		r20
00007c 913f                      	pop		r19
00007d 912f                      	pop		r18
00007e 911f                      	pop		r17
00007f 910f                      	pop		r16
000080 bf0f                      	out		SREG, r16
000081 910f                      	pop		r16 
                                 .include "spi.asm"
000082 9518                      
                                 .equ DD_SCK = PB7
                                 .equ DDR_SPI = DDRB
                                 .equ S_SELECT = PB4
                                 	
                                 .cseg
                                 SPI_INIT:
000083 eb10                      	ldi		r17, (1<<DD_MOSI) | (1<<DD_SCK) | (1<<S_SELECT)
000084 bb17                      	out		DDR_SPI, r17
000085 e510                      	ldi		r17, (1<<SPE) | (1<<MSTR)
000086 b91d                      	out		SPCR, r17
000087 e011                      	ldi		r17, (1<<SPI2X)
000088 b91e                      	out		SPSR, r17
000089 9508                      	ret
                                 
                                 LATCH_RESET:
00008a 98c4                      	cbi		PORTB, S_SELECT
00008b 9508                      	ret
                                 
                                 LATCH:
00008c 9ac4                      	sbi		PORTB, S_SELECT
00008d 9508                      	ret
                                 
                                 TRANSMIT:
00008e b90f                      	out		SPDR, r16
                                 WAIT:
00008f 9b77                      	sbis	SPSR, SPIF
000090 cffe                      	rjmp	WAIT
000091 986f                      	cbi		SPCR, SPIE
                                 .include "twi.asm"
000092 9508                      
                                 	.equ	TWI_STOP_DELAY = $A4
                                 
                                 .macro TOUT
                                 	push	r16
                                 	rcall	TWI_STARTBIT
                                 	ldi		r16, @0
                                 	lsl		r16
                                 	out		TWDR, r16
                                 	rcall	TWI_WAIT
                                 	pop		r16
                                 
                                 	mov		r16, @1
                                 	rcall	TWI_WRITE
                                 	rcall	TWI_STOP
                                 .endmacro
                                 
                                 TIN:
000093 930f                      	push	r16
000094 d009                      	rcall	TWI_STARTBIT
000095 e207                      	ldi		r16, BUTTON_ADDRESS
000096 0f00                      	lsl		r16
000097 9503                      	inc		r16
000098 b903                      	out		TWDR, r16
000099 d012                      	rcall	TWI_WAIT
00009a 910f                      	pop		r16
00009b d00d                      	rcall	TWI_READ
00009c d004                      	rcall	TWI_STOP
00009d 9508                      	ret
                                 
                                 TWI_STARTBIT:
00009e ea04                      	ldi		r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
00009f bf06                      	out		TWCR, r16
0000a0 c00d                      	rjmp	TWCR_WAIT
                                 
                                 TWI_STOP:
0000a1 e904                      	ldi		r16, (1<<TWINT)|(1<<TWSTO)|(1<<TWEN)
0000a2 bf06                      	out		TWCR, r16
0000a3 ea04                      	ldi		r16, TWI_STOP_DELAY
                                 TWI_DELAY:
0000a4 950a                      	dec		r16
0000a5 f7f1                      	brne	TWI_DELAY
0000a6 9508                      	ret
                                 
                                 TWI_WRITE:
0000a7 b903                      	out		TWDR, r16
0000a8 c003                      	rjmp	TWI_WAIT 
                                 
                                 TWI_READ:
0000a9 d002                      	rcall	TWI_WAIT	
0000aa b133                      	in		r19, TWDR
0000ab 9508                      	ret
                                 
                                 TWI_WAIT:
0000ac e804                      	ldi		r16, (1<<TWINT)|(1<<TWEN)
0000ad bf06                      	out		TWCR, r16
                                 TWCR_WAIT:
0000ae b706                      	in		r16, TWCR
0000af ff07                      	sbrs	r16, TWINT
0000b0 cffd                      	rjmp	TWCR_WAIT
0000b1 9508                      	ret
                                 
                                 TWI_OPEN:
0000b2 e906                      	ldi		r16, TWI_BAUD_RATE
0000b3 b900                      	out		TWBR, r16
0000b4 2700                      	clr		r16
0000b5 b901                      	out		TWSR, r16
0000b6 e004                      	ldi		r16, (1<<TWEN)
0000b7 bf06                      	out		TWCR, r16
