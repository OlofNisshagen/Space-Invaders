0000d8 940e 00fa                 	call	SEND_NIBBLE 
                                 
0000da 2744                      	clr		r20
0000db 940e 00fa                 	call	SEND_NIBBLE
0000dd e140                      	ldi		r20, $10 
0000de e032                      	ldi		r19, 2 
0000df 940e 0290                 	call	LCD_DELAY   ;0x01 clear display, vänta 2ms 
                                 
0000e1 2744                      	clr		r20
0000e2 940e 00fa                 	call	SEND_NIBBLE 
0000e4 e640                      	ldi		r20, $60 
0000e5 940e 00fa                 	call	SEND_NIBBLE     ; 0x06 entry mode
                                 
0000e7 2744                      	clr		r20 
0000e8 940e 00fa                 	call	SEND_NIBBLE 
0000ea ec40                      	ldi		r20, $C0 
0000eb 940e 00fa                 	call	SEND_NIBBLE      ; 0x0C display on 
                                   
0000ed 9220 006c                 	sts		LCD_MAIN_PLAYED,r2
0000ef 9220 006d                 	sts		LCD_GAMEOVER_PLAYED,r2  
0000f1 940e 01b9                 	call	RESET_POINTS
